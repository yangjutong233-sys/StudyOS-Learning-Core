{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "timezone",
    "status",
    "week"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ]
    },
    "week": {
      "type": "object",
      "required": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ]
    }
  }
}
