{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "report_id",
    "version",
    "task_id",
    "task_version",
    "session_id",
    "covered",
    "checkpoint",
    "attempts"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "task_version": {
      "type": "integer",
      "minimum": 1
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answer",
          "process",
          "form",
          "assistance",
          "evaluation"
        ]
      }
    }
  }
}
