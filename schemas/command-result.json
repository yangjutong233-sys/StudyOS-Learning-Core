{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "data",
    "warnings",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array"
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
